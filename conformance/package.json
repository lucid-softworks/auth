    "check:autumn-schema": "node generate-autumn-schema.mjs --check",
    "test:creem": "vitest run creem.test.mjs",
    "test:commet": "vitest run commet.test.mjs",
    "test:dodo-payments": "vitest run dodopayments.test.mjs",
    "test:have-i-been-pwned": "vitest run have-i-been-pwned.test.mjs",
    "test:polar": "vitest run polar.test.mjs polar-schema.test.mjs && npm run check:polar-schema",
    "generate:polar-schema": "node generate-polar-schema.mjs",
    "check:polar-schema": "node generate-polar-schema.mjs --check",
    "test:stripe": "vitest run stripe.test.mjs",
    "test:test-utils": "vitest run test-utils.test.mjs"
  },
